// Collab Engine — Prisma Schema
//
// Schema inicial com entidades core (Tenant, User, Project, Stakeholder).
// Módulos M1-M16 são adicionados incrementalmente nos sprints.
//
// Convenções:
// - Multi-tenant via tenantId (ADR-006)
// - Soft delete com deletedAt + deletedBy (ADR-003)
// - Escala 5x5 nas entidades de governança (ADR-001)
// - Cargo separado de Função (ADR-004)
//
// Ler skills/prisma-migrations/SKILL.md antes de modificar este arquivo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// TENANT (ADR-006)
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  plan      PlanType @default(STARTER)
  active    Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  projects      Project[]
  stakeholders  Stakeholder[]
  cargos        Cargo[]
  funcoes       Funcao[]
  areas         Area[]
  changeImpacts ChangeImpact[]
  trainingPlans TrainingPlan[]

  @@index([slug])
}

enum PlanType {
  INTERNAL // CollabZ uso interno
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ═══════════════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String
  name         String
  passwordHash String?   // bcrypt; null se SSO externo
  role         UserRole  @default(EMPLOYEE)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  preferences  Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  projectMemberships ProjectMember[]
  loginAttempts      LoginAttempt[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([deletedAt])
}

enum UserRole {
  ADMIN
  CHANGE_MANAGER
  PROJECT_MANAGER
  SPONSOR
  TEAM_LEAD
  EMPLOYEE
  READ_ONLY
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// PROJECT
// ═══════════════════════════════════════════════════════════════

model Project {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  name             String
  description      String?
  projectType      ProjectType
  deliveryModel    DeliveryModel @default(HYBRID)
  methodologyStack String[]      @default([])
  status           ProjectStatus @default(PLANNING)
  complexityScore  Float?
  startDate        DateTime?
  targetEndDate    DateTime?
  actualEndDate    DateTime?

  // Referências externas (sistemas integrados)
  smrProjectId     String?       // ID no SMR Projetos

  settings         Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  members           ProjectMember[]
  changeImpacts     ChangeImpact[]
  stakeholderLinks  ProjectStakeholder[]
  trainingPlans     TrainingPlan[]

  @@index([tenantId])
  @@index([status])
  @@index([deletedAt])
}

enum ProjectType {
  ERP_IMPLEMENTATION
  DIGITAL_TRANSFORMATION
  INFRASTRUCTURE
  MERGER_ACQUISITION
  INNOVATION
  SOCIAL_IMPACT
  LEAN_SIX_SIGMA
  CULTURAL_TRANSFORMATION
}

enum DeliveryModel {
  WATERFALL
  AGILE
  HYBRID
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  CLOSING
  COMPLETED
  ARCHIVED
}

model ProjectMember {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  projectRole ProjectMemberRole
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  @@unique([projectId, userId])
  @@index([deletedAt])
}

enum ProjectMemberRole {
  CHANGE_LEAD
  CHANGE_MANAGER
  CHANGE_AGENT
  SPONSOR
  TEAM_LEAD
  STAKEHOLDER
  OBSERVER
}

// ═══════════════════════════════════════════════════════════════
// STAKEHOLDER (M2 — Sprint 3)
// ═══════════════════════════════════════════════════════════════

enum StakeholderLevel {
  C_LEVEL
  EXECUTIVE
  MIDDLE_MANAGEMENT
  OPERATIONAL
  EXTERNAL
}

enum StakeholderPosition {
  CHAMPION
  SUPPORTER
  NEUTRAL
  RESISTOR
  ANTAGONIST
}

model Stakeholder {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  name              String
  email             String?
  hrisId            String?            // ID externo no HRIS
  position          String?            // cargo/posição (texto livre)
  organizationLevel StakeholderLevel?

  pessoaId          String?            // FK para Pessoa (se também for cadastrada)
  pessoa            Pessoa?            @relation(fields: [pessoaId], references: [id])

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  projectLinks      ProjectStakeholder[]

  @@index([tenantId])
  @@index([deletedAt])
}

model ProjectStakeholder {
  id            String              @id @default(uuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id])
  stakeholderId String
  stakeholder   Stakeholder         @relation(fields: [stakeholderId], references: [id])

  position      StakeholderPosition
  influence     Int                 @db.SmallInt  // 1-5
  interest      Int                 @db.SmallInt  // 1-5

  notes             String?
  lastContactDate   DateTime?

  // ADKAR scores (0-5 por dimensão)
  adkarA            Int?     @db.SmallInt  // Awareness
  adkarD            Int?     @db.SmallInt  // Desire
  adkarK            Int?     @db.SmallInt  // Knowledge
  adkarAb           Int?     @db.SmallInt  // Ability
  adkarR            Int?     @db.SmallInt  // Reinforcement

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@unique([projectId, stakeholderId])
  @@index([projectId])
  @@index([stakeholderId])
  @@index([position])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════
// PESSOA, CARGO, FUNÇÃO (ADR-004 — esqueleto, detalhes em sprint-4)
// ═══════════════════════════════════════════════════════════════

model Pessoa {
  id        String   @id @default(uuid())
  tenantId  String
  nome      String
  email     String?
  cpf       String?
  hrisId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  cargosHistorico PessoaCargo[]
  funcoesAtuais   PessoaFuncao[]
  stakeholders    Stakeholder[]
  treinamentos    PessoaTreinamento[]

  @@index([tenantId])
  @@index([email])
  @@index([deletedAt])
}

model Cargo {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  nome      String
  nivel     String?
  descricao String?
  createdAt DateTime    @default(now())
  deletedAt DateTime?

  pessoas PessoaCargo[]

  @@unique([tenantId, nome])
  @@index([deletedAt])
}

model PessoaCargo {
  id         String    @id @default(uuid())
  pessoaId   String
  pessoa     Pessoa    @relation(fields: [pessoaId], references: [id])
  cargoId    String
  cargo      Cargo     @relation(fields: [cargoId], references: [id])
  dataInicio DateTime
  dataFim    DateTime? // null = vigente
  createdAt  DateTime  @default(now())

  @@index([pessoaId, dataFim])
  @@index([cargoId])
}

model Funcao {
  id        String         @id @default(uuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  nome      String
  descricao String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  pessoas     PessoaFuncao[]
  processos   FuncaoProcesso[]
  treinamentos FuncaoTreinamento[]

  @@unique([tenantId, nome])
  @@index([deletedAt])
}

model PessoaFuncao {
  id         String    @id @default(uuid())
  pessoaId   String
  pessoa     Pessoa    @relation(fields: [pessoaId], references: [id])
  funcaoId   String
  funcao     Funcao    @relation(fields: [funcaoId], references: [id])
  dataInicio DateTime  @default(now())
  dataFim    DateTime?
  createdAt  DateTime  @default(now())

  @@unique([pessoaId, funcaoId, dataInicio])
  @@index([funcaoId, dataFim])
}

model FuncaoProcesso {
  id              String          @id @default(uuid())
  funcaoId        String
  funcao          Funcao          @relation(fields: [funcaoId], references: [id])

  // Referência externa: processo vive no XPROC
  xprocProcessoId String

  papel           PapelNoProcesso // RACI
  observacao      String?
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?

  @@unique([funcaoId, xprocProcessoId])
  @@index([deletedAt])
}

enum PapelNoProcesso {
  RESPONSIBLE
  ACCOUNTABLE
  CONSULTED
  INFORMED
}

// ═══════════════════════════════════════════════════════════════
// AREA (estrutura organizacional — esqueleto)
// ═══════════════════════════════════════════════════════════════

model Area {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  nome     String
  parentId String? // hierarquia organizacional
  parent   Area?   @relation("AreaHierarchy", fields: [parentId], references: [id])
  children Area[]  @relation("AreaHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  impactAreas ImpactArea[]

  @@unique([tenantId, nome])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════
// CHANGE IMPACT (M3 — Gestão de Mudança Organizacional, Sprint 2)
// ═══════════════════════════════════════════════════════════════

enum ImpactDimension {
  PROCESS
  PEOPLE
  TECHNOLOGY
  STRUCTURE
  CULTURE
  POLICY
  METRICS
}

enum ImpactStatus {
  DRAFT
  ACTIVE
  MITIGATING
  RESOLVED
  CLOSED
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model ChangeImpact {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  title         String
  description   String?
  dimension     ImpactDimension
  status        ImpactStatus    @default(DRAFT)

  // 5x5 scoring: severityScore × extentScore = score (ADR-001)
  severityScore Int             // 1-5: quão grave é o impacto
  extentScore   Int             // 1-5: quantas pessoas/áreas afeta
  score         Int             // computed: severityScore × extentScore

  mitigation    String?

  createdBy     String          // userId
  updatedBy     String?         // userId
  deletedAt     DateTime?
  deletedBy     String?         // userId
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  activities      ImpactActivity[]
  areas           ImpactArea[]
  acompanhamentos ImpactAcompanhamento[]

  @@index([tenantId])
  @@index([projectId])
  @@index([dimension])
  @@index([status])
  @@index([deletedAt])
}

model ImpactActivity {
  id            String         @id @default(uuid())
  impactId      String
  impact        ChangeImpact   @relation(fields: [impactId], references: [id])
  title         String
  description   String?
  status        ActivityStatus @default(PENDING)
  dueDate       DateTime?
  assignedTo    String?        // userId
  smrActivityId String?        @unique // ID no SMR Projetos (Issue 017)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([impactId])
  @@index([deletedAt])
}

model ImpactArea {
  id        String       @id @default(uuid())
  impactId  String
  impact    ChangeImpact @relation(fields: [impactId], references: [id])
  areaId    String
  area      Area         @relation(fields: [areaId], references: [id])
  note      String?
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  @@unique([impactId, areaId])
  @@index([deletedAt])
}

model ImpactAcompanhamento {
  id             String        @id @default(uuid())
  impactId       String
  impact         ChangeImpact  @relation(fields: [impactId], references: [id])
  previousStatus ImpactStatus?
  newStatus      ImpactStatus
  previousScore  Int?
  newScore       Int
  note           String?
  changedBy      String        // userId
  changedAt      DateTime      @default(now())

  @@index([impactId, changedAt])
}

// ═══════════════════════════════════════════════════════════════
// M5 — TREINAMENTO (Sprint 4, Issue 022)
// ═══════════════════════════════════════════════════════════════

model TrainingPlan {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id])

  name        String
  description String?
  status      TrainingPlanStatus @default(DRAFT)

  startDate   DateTime?
  endDate     DateTime?

  items       TrainingItem[]

  createdBy   String             // userId
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}

enum TrainingPlanStatus {
  DRAFT
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

model TrainingItem {
  id          String     @id @default(uuid())
  planId      String
  plan        TrainingPlan @relation(fields: [planId], references: [id])

  title       String
  description String?
  duration    Int?       // minutos
  modality    Modality

  funcoes     FuncaoTreinamento[]
  pessoas     PessoaTreinamento[]
  turmas      Turma[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([planId])
  @@index([deletedAt])
}

enum Modality {
  PRESENCIAL
  ONLINE
  HIBRIDO
  AUTOESTUDO
}

model FuncaoTreinamento {
  id             String       @id @default(uuid())
  trainingItemId String
  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id])
  funcaoId       String
  funcao         Funcao       @relation(fields: [funcaoId], references: [id])

  obrigatorio    Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([trainingItemId, funcaoId])
}

model PessoaTreinamento {
  id             String         @id @default(uuid())
  trainingItemId String
  trainingItem   TrainingItem   @relation(fields: [trainingItemId], references: [id])
  pessoaId       String
  pessoa         Pessoa         @relation(fields: [pessoaId], references: [id])

  derivedFromFuncao Boolean       @default(true)
  status            TrainingStatus @default(PENDENTE)

  inscricoes     InscricaoTurma[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@unique([trainingItemId, pessoaId])
  @@index([deletedAt])
}

enum TrainingStatus {
  PENDENTE
  INSCRITO
  EM_ANDAMENTO
  CONCLUIDO
  AUSENTE
  DISPENSADO
}

model Turma {
  id             String       @id @default(uuid())
  trainingItemId String
  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id])

  nome       String
  dataInicio DateTime
  dataFim    DateTime
  modality   Modality
  local      String?
  instrutorId String?      // userId
  capacidade  Int?
  status      TurmaStatus  @default(AGENDADA)

  inscricoes  InscricaoTurma[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([trainingItemId])
  @@index([status])
  @@index([dataInicio])
  @@index([deletedAt])
}

enum TurmaStatus {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model InscricaoTurma {
  id                  String            @id @default(uuid())
  turmaId             String
  turma               Turma             @relation(fields: [turmaId], references: [id])
  pessoaTreinamentoId String
  pessoaTreinamento   PessoaTreinamento @relation(fields: [pessoaTreinamentoId], references: [id])

  presente        Boolean?  // null = não marcado; true = presente; false = ausente
  notaAvaliacao   Int?      @db.SmallInt // 1-5
  observacao      String?
  conviteEnviadoEm DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([turmaId, pessoaTreinamentoId])
  @@index([turmaId])
}

// ═══════════════════════════════════════════════════════════════
// SMR WEBHOOK LOG (Issue 017 — integração SMR Projetos)
// ═══════════════════════════════════════════════════════════════

model SmrWebhookLog {
  id          String    @id @default(uuid())
  eventId     String    @unique // SMR-generated event ID (idempotency key)
  activityId  String?           // ImpactActivity.id resolvido
  payload     Json              // payload recebido
  status      String    @default("RECEIVED") // RECEIVED/PROCESSING/PROCESSED/FAILED/IGNORED
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// EVENTO INTEGRACAO (cron-based event bus — ADR-002)
// ═══════════════════════════════════════════════════════════════

model EventoIntegracao {
  id          String        @id @default(uuid())
  tipo        String        // ex: "impacto.criado", "treinamento.concluido"
  payload     Json
  origem      SistemaOrigem // SMR, XPROC, COLLAB
  destino     SistemaOrigem? // null = broadcast
  status      StatusEvento  @default(PENDENTE)
  tentativas  Int           @default(0)
  ultimoErro  String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([tipo, createdAt])
}

enum SistemaOrigem {
  SMR
  XPROC
  COLLAB
}

enum StatusEvento {
  PENDENTE
  PROCESSANDO
  PROCESSADO
  FALHADO
  DESCARTADO
}
