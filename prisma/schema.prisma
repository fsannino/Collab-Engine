// Collab Engine — Prisma Schema
//
// Schema inicial com entidades core (Tenant, User, Project, Stakeholder).
// Módulos M1-M16 são adicionados incrementalmente nos sprints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// TENANT
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  plan      PlanType @default(STARTER)
  active    Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  projects           Project[]
  stakeholders       Stakeholder[]
  pessoas            Pessoa[]
  cargos             Cargo[]
  funcoes            Funcao[]
  areas              Area[]
  processos          Processo[]
  macroprocessos     Macroprocesso[]
  changeImpacts      ChangeImpact[]
  trainingPlans      TrainingPlan[]
  avaliacoesCultura  AvaliacaoCultura[]
  liderancas         Lideranca[]

  @@index([slug])
}

enum PlanType {
  INTERNAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ═══════════════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String
  name         String
  passwordHash String?
  role         UserRole  @default(EMPLOYEE)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  preferences  Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  projectMemberships ProjectMember[]
  loginAttempts      LoginAttempt[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([deletedAt])
}

enum UserRole {
  ADMIN
  CHANGE_MANAGER
  PROJECT_MANAGER
  SPONSOR
  TEAM_LEAD
  EMPLOYEE
  READ_ONLY
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// PROJECT
// ═══════════════════════════════════════════════════════════════

model Project {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  name             String
  description      String?
  projectType      ProjectType
  deliveryModel    DeliveryModel @default(HYBRID)
  methodologyStack String[]      @default([])
  status           ProjectStatus @default(PLANNING)
  complexityScore  Float?
  startDate        DateTime?
  targetEndDate    DateTime?
  actualEndDate    DateTime?
  smrProjectId     String?
  settings         Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  members            ProjectMember[]
  changeImpacts      ChangeImpact[]
  stakeholderLinks   ProjectStakeholder[]
  trainingPlans      TrainingPlan[]
  avaliacoesCultura  AvaliacaoCultura[]
  liderancas         Lideranca[]

  @@index([tenantId])
  @@index([status])
  @@index([deletedAt])
}

enum ProjectType {
  ERP_IMPLEMENTATION
  DIGITAL_TRANSFORMATION
  INFRASTRUCTURE
  MERGER_ACQUISITION
  INNOVATION
  SOCIAL_IMPACT
  LEAN_SIX_SIGMA
  CULTURAL_TRANSFORMATION
}

enum DeliveryModel {
  WATERFALL
  AGILE
  HYBRID
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  CLOSING
  COMPLETED
  ARCHIVED
}

model ProjectMember {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  projectRole ProjectMemberRole
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  @@unique([projectId, userId])
  @@index([deletedAt])
}

enum ProjectMemberRole {
  CHANGE_LEAD
  CHANGE_MANAGER
  CHANGE_AGENT
  SPONSOR
  TEAM_LEAD
  STAKEHOLDER
  OBSERVER
}

// ═══════════════════════════════════════════════════════════════
// STAKEHOLDER (M2)
// ═══════════════════════════════════════════════════════════════

enum StakeholderLevel {
  C_LEVEL
  EXECUTIVE
  MIDDLE_MANAGEMENT
  OPERATIONAL
  EXTERNAL
}

enum StakeholderPosition {
  CHAMPION
  SUPPORTER
  NEUTRAL
  RESISTOR
  ANTAGONIST
}

model Stakeholder {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  name              String
  email             String?
  hrisId            String?
  position          String?
  organizationLevel StakeholderLevel?
  pessoaId          String?
  pessoa            Pessoa?            @relation(fields: [pessoaId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  projectLinks ProjectStakeholder[]

  @@index([tenantId])
  @@index([deletedAt])
}

model ProjectStakeholder {
  id            String              @id @default(uuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id])
  stakeholderId String
  stakeholder   Stakeholder         @relation(fields: [stakeholderId], references: [id])
  position      StakeholderPosition
  influence     Int                 @db.SmallInt
  interest      Int                 @db.SmallInt
  notes             String?
  lastContactDate   DateTime?
  adkarA            Int?     @db.SmallInt
  adkarD            Int?     @db.SmallInt
  adkarK            Int?     @db.SmallInt
  adkarAb           Int?     @db.SmallInt
  adkarR            Int?     @db.SmallInt
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@unique([projectId, stakeholderId])
  @@index([projectId])
  @@index([stakeholderId])
  @@index([position])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════
// PESSOA, CARGO, FUNÇÃO
// ═══════════════════════════════════════════════════════════════

model Pessoa {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  nome                String
  email               String?
  cpf                 String?
  hrisId              String?
  areaId              String?
  area                Area?    @relation("PessoaArea", fields: [areaId], references: [id])
  superiorId          String?
  superior            Pessoa?  @relation("PessoaHierarquia", fields: [superiorId], references: [id])
  subordinados        Pessoa[] @relation("PessoaHierarquia")
  localidadeTrabalho  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  cargosHistorico     PessoaCargo[]
  funcoesAtuais       PessoaFuncao[]
  stakeholders        Stakeholder[]
  treinamentos        PessoaTreinamento[]
  turmasComoInstrutor TurmaInstrutor[]
  convitesOcai        ConviteOcai[]      @relation("PessoaConvitesOcai")
  liderancas          Lideranca[]

  @@index([tenantId])
  @@index([email])
  @@index([areaId])
  @@index([deletedAt])
}

model Cargo {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  nome      String
  nivel     String?
  descricao String?
  areaId    String?
  area      Area?       @relation("CargoArea", fields: [areaId], references: [id])
  createdAt DateTime    @default(now())
  deletedAt DateTime?

  pessoas PessoaCargo[]

  @@unique([tenantId, nome])
  @@index([areaId])
  @@index([deletedAt])
}

model PessoaCargo {
  id         String    @id @default(uuid())
  pessoaId   String
  pessoa     Pessoa    @relation(fields: [pessoaId], references: [id])
  cargoId    String
  cargo      Cargo     @relation(fields: [cargoId], references: [id])
  dataInicio DateTime
  dataFim    DateTime?
  createdAt  DateTime  @default(now())

  @@index([pessoaId, dataFim])
  @@index([cargoId])
}

model Funcao {
  id        String         @id @default(uuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  nome      String
  descricao String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  pessoas     PessoaFuncao[]
  processos   FuncaoProcesso[]
  treinamentos FuncaoTreinamento[]

  @@unique([tenantId, nome])
  @@index([deletedAt])
}

model PessoaFuncao {
  id         String    @id @default(uuid())
  pessoaId   String
  pessoa     Pessoa    @relation(fields: [pessoaId], references: [id])
  funcaoId   String
  funcao     Funcao    @relation(fields: [funcaoId], references: [id])
  dataInicio DateTime  @default(now())
  dataFim    DateTime?
  createdAt  DateTime  @default(now())

  @@unique([pessoaId, funcaoId, dataInicio])
  @@index([funcaoId, dataFim])
}

model FuncaoProcesso {
  id              String          @id @default(uuid())
  funcaoId        String
  funcao          Funcao          @relation(fields: [funcaoId], references: [id])
  processoId      String?
  processo        Processo?       @relation(fields: [processoId], references: [id])
  xprocProcessoId String?
  papel           PapelNoProcesso
  observacao      String?
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?

  @@index([funcaoId])
  @@index([processoId])
  @@index([deletedAt])
}

enum PapelNoProcesso {
  RESPONSIBLE
  ACCOUNTABLE
  CONSULTED
  INFORMED
}

// ═══════════════════════════════════════════════════════════════
// AREA
// ═══════════════════════════════════════════════════════════════

model Area {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  nome      String
  descricao String?
  parentId  String?
  parent   Area?   @relation("AreaHierarchy", fields: [parentId], references: [id])
  children Area[]  @relation("AreaHierarchy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  impactAreas       ImpactArea[]
  pessoas           Pessoa[]          @relation("PessoaArea")
  cargos            Cargo[]           @relation("CargoArea")
  avaliacoesCultura AvaliacaoCultura[] @relation("AreaAvaliacoes")
  liderancas        Lideranca[]

  @@unique([tenantId, nome])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════
// CHANGE IMPACT (M3)
// ═══════════════════════════════════════════════════════════════

enum ImpactDimension {
  PROCESS
  PEOPLE
  TECHNOLOGY
  STRUCTURE
  CULTURE
  POLICY
  METRICS
}

enum ImpactStatus {
  DRAFT
  ACTIVE
  MITIGATING
  RESOLVED
  CLOSED
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model ChangeImpact {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  title         String
  description   String?
  dimension     ImpactDimension
  status        ImpactStatus    @default(DRAFT)
  severityScore Int
  extentScore   Int
  score         Int
  mitigation    String?
  createdBy     String
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  activities       ImpactActivity[]
  areas            ImpactArea[]
  acompanhamentos  ImpactAcompanhamento[]

  @@index([tenantId])
  @@index([projectId])
  @@index([dimension])
  @@index([status])
  @@index([deletedAt])
}

model ImpactActivity {
  id            String         @id @default(uuid())
  impactId      String
  impact        ChangeImpact   @relation(fields: [impactId], references: [id])
  title         String
  description   String?
  status        ActivityStatus @default(PENDING)
  dueDate       DateTime?
  assignedTo    String?
  smrActivityId String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([impactId])
  @@index([deletedAt])
}

model ImpactArea {
  id        String       @id @default(uuid())
  impactId  String
  impact    ChangeImpact @relation(fields: [impactId], references: [id])
  areaId    String
  area      Area         @relation(fields: [areaId], references: [id])
  note      String?
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  @@unique([impactId, areaId])
  @@index([deletedAt])
}

model ImpactAcompanhamento {
  id             String        @id @default(uuid())
  impactId       String
  impact         ChangeImpact  @relation(fields: [impactId], references: [id])
  previousStatus ImpactStatus?
  newStatus      ImpactStatus
  previousScore  Int?
  newScore       Int
  note           String?
  changedBy      String
  changedAt      DateTime      @default(now())

  @@index([impactId, changedAt])
}

// ═══════════════════════════════════════════════════════════════
// M5 — TREINAMENTO (Sprint 4, Issue 022)
// ═══════════════════════════════════════════════════════════════

model TrainingPlan {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id])

  name        String
  description String?
  status      TrainingPlanStatus @default(DRAFT)

  startDate   DateTime?
  endDate     DateTime?

  items       TrainingItem[]

  createdBy   String             // userId
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}

enum TrainingPlanStatus {
  DRAFT
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

model TrainingItem {
  id          String     @id @default(uuid())
  planId      String
  plan        TrainingPlan @relation(fields: [planId], references: [id])

  title       String
  description String?
  duration    Int?       // minutos
  modality    Modality

  funcoes     FuncaoTreinamento[]
  pessoas     PessoaTreinamento[]
  turmas      Turma[]
  materiais   TrainingMaterial[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([planId])
  @@index([deletedAt])
}

enum Modality {
  PRESENCIAL
  ONLINE
  HIBRIDO
  AUTOESTUDO
  DINAMICA
  ONE_ON_ONE
  MULTIPLICADOR
}

model FuncaoTreinamento {
  id             String       @id @default(uuid())
  trainingItemId String
  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id])
  funcaoId       String
  funcao         Funcao       @relation(fields: [funcaoId], references: [id])

  obrigatorio    Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([trainingItemId, funcaoId])
}

model PessoaTreinamento {
  id             String         @id @default(uuid())
  trainingItemId String
  trainingItem   TrainingItem   @relation(fields: [trainingItemId], references: [id])
  pessoaId       String
  pessoa         Pessoa         @relation(fields: [pessoaId], references: [id])

  derivedFromFuncao Boolean       @default(true)
  status            TrainingStatus @default(PENDENTE)

  inscricoes     InscricaoTurma[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@unique([trainingItemId, pessoaId])
  @@index([deletedAt])
}

enum TrainingStatus {
  PENDENTE
  INSCRITO
  EM_ANDAMENTO
  CONCLUIDO
  AUSENTE
  DISPENSADO
}

model Turma {
  id             String       @id @default(uuid())
  trainingItemId String
  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id])

  nome                String
  dataInicio          DateTime
  dataFim             DateTime
  modality            Modality
  local               String?
  capacidade          Int?
  notaLimiteAprovacao Float?   // nota mínima de aprovação (ex: 60.0)
  status              TurmaStatus @default(AGENDADA)

  inscricoes  InscricaoTurma[]
  instrutores TurmaInstrutor[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([trainingItemId])
  @@index([status])
  @@index([dataInicio])
  @@index([deletedAt])
}

enum TurmaStatus {
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model InscricaoTurma {
  id                  String            @id @default(uuid())
  turmaId             String
  turma               Turma             @relation(fields: [turmaId], references: [id])
  pessoaTreinamentoId String
  pessoaTreinamento   PessoaTreinamento @relation(fields: [pessoaTreinamentoId], references: [id])

  presente         Boolean?  // null = não marcado; true = presente; false = ausente
  notaAvaliacao    Int?      @db.SmallInt // avaliação qualitativa 1-5
  notaExame        Float?    // nota da prova (escala definida pela turma, ex: 0-100)
  aprovado         Boolean?  // calculado: notaExame >= turma.notaLimiteAprovacao
  observacao       String?
  conviteEnviadoEm DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([turmaId, pessoaTreinamentoId])
  @@index([turmaId])
}

// ═══════════════════════════════════════════════════════════════
// MACROPROCESSO → PROCESSO (hierarquia local, link opcional ao XPROC)
// ═══════════════════════════════════════════════════════════════

model Macroprocesso {
  id                    String    @id @default(uuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  nome                  String
  descricao             String?
  xprocMacroprocessoId  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  processos             Processo[]

  @@unique([tenantId, nome])
  @@index([tenantId])
  @@index([deletedAt])
}

model Processo {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  macroprocessoId String?
  macroprocesso   Macroprocesso? @relation(fields: [macroprocessoId], references: [id])
  nome            String
  descricao       String?
  xprocProcessoId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  funcoes         FuncaoProcesso[]

  @@index([tenantId])
  @@index([macroprocessoId])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════
// TURMA INSTRUTOR (múltiplos instrutores por turma)
// ═══════════════════════════════════════════════════════════════

model TurmaInstrutor {
  id        String   @id @default(uuid())
  turmaId   String
  turma     Turma    @relation(fields: [turmaId], references: [id])
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id])
  principal Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([turmaId, pessoaId])
  @@index([turmaId])
  @@index([pessoaId])
}

// ═══════════════════════════════════════════════════════════════
// TRAINING MATERIAL
// ═══════════════════════════════════════════════════════════════

enum MaterialTipo {
  ONLINE
  FISICO
  DIGITAL
}

model TrainingMaterial {
  id             String       @id @default(uuid())
  trainingItemId String
  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id])
  tipo           MaterialTipo
  titulo         String
  url            String?
  descricao      String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([trainingItemId])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════
// SMR WEBHOOK LOG (Issue 017 — integração SMR Projetos)
// ═══════════════════════════════════════════════════════════════

model SmrWebhookLog {
  id          String    @id @default(uuid())
  eventId     String    @unique
  activityId  String?
  payload     Json
  status      String    @default("RECEIVED")
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// EVENTO INTEGRACAO
// ═══════════════════════════════════════════════════════════════

model EventoIntegracao {
  id          String         @id @default(uuid())
  tipo        String
  payload     Json
  origem      SistemaOrigem
  destino     SistemaOrigem?
  status      StatusEvento   @default(PENDENTE)
  tentativas  Int            @default(0)
  ultimoErro  String?
  createdAt   DateTime       @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([tipo, createdAt])
}

enum SistemaOrigem {
  SMR
  XPROC
  COLLAB
}

enum StatusEvento {
  PENDENTE
  PROCESSANDO
  PROCESSADO
  FALHADO
  DESCARTADO
}

// ═══════════════════════════════════════════════════════════════
// CULTURA ORGANIZACIONAL — OCAI (Sprint 5)
// ═══════════════════════════════════════════════════════════════

enum AvaliacaoTipo {
  PROJETO  // vinculada a um Project
  AREA     // vinculada a uma Area
  LIVRE    // standalone / diagnóstico livre
}

enum AvaliacaoStatus {
  RASCUNHO
  ATIVA
  ENCERRADA
}

model AvaliacaoCultura {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  nome        String
  descricao   String?
  tipo        AvaliacaoTipo    @default(LIVRE)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])
  areaId      String?
  area        Area?            @relation("AreaAvaliacoes", fields: [areaId], references: [id])
  status      AvaliacaoStatus  @default(RASCUNHO)
  dataInicio  DateTime?
  dataFim     DateTime?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  convites    ConviteOcai[]
  respostas   RespostaOcai[]

  @@index([tenantId])
  @@index([projectId])
  @@index([areaId])
  @@index([status])
  @@index([deletedAt])
}

model ConviteOcai {
  id           String            @id @default(uuid())
  avaliacaoId  String
  avaliacao    AvaliacaoCultura  @relation(fields: [avaliacaoId], references: [id])
  pessoaId     String?
  pessoa       Pessoa?           @relation("PessoaConvitesOcai", fields: [pessoaId], references: [id])
  email        String
  nome         String
  token        String            @unique @default(uuid())
  respondidoEm DateTime?
  createdAt    DateTime          @default(now())

  resposta     RespostaOcai?

  @@index([avaliacaoId])
  @@index([token])
}

model RespostaOcai {
  id          String            @id @default(uuid())
  avaliacaoId String
  avaliacao   AvaliacaoCultura  @relation(fields: [avaliacaoId], references: [id])
  conviteId   String?           @unique
  convite     ConviteOcai?      @relation(fields: [conviteId], references: [id])
  // JSON: { DIM: { atual: {CLAN,ADHOCRACY,MARKET,HIERARCHY}, desejado: {...} } }
  respostas   Json
  manual      Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([avaliacaoId])
}

// ═══════════════════════════════════════════════════════════════
// NOTIFICATION LOG (M5 — Issue 027)
// ═══════════════════════════════════════════════════════════════

enum NotificationLogType {
  OVERDUE_TRAINING
  TURMA_REMINDER
  ATTENDANCE_REMINDER
}

model NotificationLog {
  id             String              @id @default(uuid())
  tenantId       String
  type           NotificationLogType
  recipientEmail String
  subject        String
  refId          String?             // turmaId or planId for deduplication

  createdAt      DateTime            @default(now())

  @@index([tenantId])
  @@index([type, refId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// LIDERANÇA (M7 — Leadership Console)
// ═══════════════════════════════════════════════════════════════

model Lideranca {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  pessoaId  String
  pessoa    Pessoa    @relation(fields: [pessoaId], references: [id])
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  areaId    String?
  area      Area?     @relation(fields: [areaId], references: [id])
  papel     String
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  avaliacoes AvaliacaoLideranca[]

  @@index([tenantId])
  @@index([pessoaId])
  @@index([projectId])
  @@index([deletedAt])
}

model AvaliacaoLideranca {
  id          String    @id @default(uuid())
  liderancaId String
  lideranca   Lideranca @relation(fields: [liderancaId], references: [id])
  dimensao    String
  pontuacao   Float
  observacao  String?
  avaliadoPor String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([liderancaId, dimensao])
  @@index([liderancaId])
}
