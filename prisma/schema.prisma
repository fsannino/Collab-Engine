// Collab Engine — Prisma Schema
//
// Schema inicial com entidades core (Tenant, User, Project, Stakeholder).
// Módulos M1-M16 são adicionados incrementalmente nos sprints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// TENANT
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  plan      PlanType @default(STARTER)
  active    Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  projects         Project[]
  stakeholders     Stakeholder[]
  cargos           Cargo[]
  funcoes          Funcao[]
  areas            Area[]
  changeImpacts    ChangeImpact[]
  trainingMatrices TrainingMatrix[]

  @@index([slug])
}

enum PlanType {
  INTERNAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ═══════════════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String
  name         String
  passwordHash String?
  role         UserRole  @default(EMPLOYEE)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  preferences  Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  projectMemberships ProjectMember[]
  loginAttempts      LoginAttempt[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([deletedAt])
}

enum UserRole {
  ADMIN
  CHANGE_MANAGER
  PROJECT_MANAGER
  SPONSOR
  TEAM_LEAD
  EMPLOYEE
  READ_ONLY
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// PROJECT
// ═══════════════════════════════════════════════════════════════

model Project {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  name             String
  description      String?
  projectType      ProjectType
  deliveryModel    DeliveryModel @default(HYBRID)
  methodologyStack String[]      @default([])
  status           ProjectStatus @default(PLANNING)
  complexityScore  Float?
  startDate        DateTime?
  targetEndDate    DateTime?
  actualEndDate    DateTime?
  smrProjectId     String?
  settings         Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  members          ProjectMember[]
  changeImpacts    ChangeImpact[]
  stakeholderLinks ProjectStakeholder[]
  trainingMatrices TrainingMatrix[]
  trainingPlans    TrainingPlan[]

  @@index([tenantId])
  @@index([status])
  @@index([deletedAt])
}

enum ProjectType {
  ERP_IMPLEMENTATION
  DIGITAL_TRANSFORMATION
  INFRASTRUCTURE
  MERGER_ACQUISITION
  INNOVATION
  SOCIAL_IMPACT
  LEAN_SIX_SIGMA
  CULTURAL_TRANSFORMATION
}

enum DeliveryModel {
  WATERFALL
  AGILE
  HYBRID
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  CLOSING
  COMPLETED
  ARCHIVED
}

model ProjectMember {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  projectRole ProjectMemberRole
  createdAt   DateTime          @default(now())
  deletedAt   DateTime?

  @@unique([projectId, userId])
  @@index([deletedAt])
}

enum ProjectMemberRole {
  CHANGE_LEAD
  CHANGE_MANAGER
  CHANGE_AGENT
  SPONSOR
  TEAM_LEAD
  STAKEHOLDER
  OBSERVER
}

// ═══════════════════════════════════════════════════════════════
// STAKEHOLDER (M2)
// ═══════════════════════════════════════════════════════════════

enum StakeholderLevel {
  C_LEVEL
  EXECUTIVE
  MIDDLE_MANAGEMENT
  OPERATIONAL
  EXTERNAL
}

enum StakeholderPosition {
  CHAMPION
  SUPPORTER
  NEUTRAL
  RESISTOR
  ANTAGONIST
}

model Stakeholder {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  name              String
  email             String?
  hrisId            String?
  position          String?
  organizationLevel StakeholderLevel?
  pessoaId          String?
  pessoa            Pessoa?            @relation(fields: [pessoaId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  projectLinks ProjectStakeholder[]

  @@index([tenantId])
  @@index([deletedAt])
}

model ProjectStakeholder {
  id            String              @id @default(uuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id])
  stakeholderId String
  stakeholder   Stakeholder         @relation(fields: [stakeholderId], references: [id])
  position      StakeholderPosition
  influence     Int                 @db.SmallInt
  interest      Int                 @db.SmallInt
  notes             String?
  lastContactDate   DateTime?
  adkarA            Int?     @db.SmallInt
  adkarD            Int?     @db.SmallInt
  adkarK            Int?     @db.SmallInt
  adkarAb           Int?     @db.SmallInt
  adkarR            Int?     @db.SmallInt
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@unique([projectId, stakeholderId])
  @@index([projectId])
  @@index([stakeholderId])
  @@index([position])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════
// PESSOA, CARGO, FUNÇÃO
// ═══════════════════════════════════════════════════════════════

model Pessoa {
  id        String   @id @default(uuid())
  tenantId  String
  nome      String
  email     String?
  cpf       String?
  hrisId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  cargosHistorico PessoaCargo[]
  funcoesAtuais   PessoaFuncao[]
  stakeholders    Stakeholder[]

  @@index([tenantId])
  @@index([email])
  @@index([deletedAt])
}

model Cargo {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  nome      String
  nivel     String?
  descricao String?
  createdAt DateTime    @default(now())
  deletedAt DateTime?

  pessoas PessoaCargo[]

  @@unique([tenantId, nome])
  @@index([deletedAt])
}

model PessoaCargo {
  id         String    @id @default(uuid())
  pessoaId   String
  pessoa     Pessoa    @relation(fields: [pessoaId], references: [id])
  cargoId    String
  cargo      Cargo     @relation(fields: [cargoId], references: [id])
  dataInicio DateTime
  dataFim    DateTime?
  createdAt  DateTime  @default(now())

  @@index([pessoaId, dataFim])
  @@index([cargoId])
}

model Funcao {
  id        String         @id @default(uuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  nome      String
  descricao String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  pessoas   PessoaFuncao[]
  processos FuncaoProcesso[]

  @@unique([tenantId, nome])
  @@index([deletedAt])
}

model PessoaFuncao {
  id         String    @id @default(uuid())
  pessoaId   String
  pessoa     Pessoa    @relation(fields: [pessoaId], references: [id])
  funcaoId   String
  funcao     Funcao    @relation(fields: [funcaoId], references: [id])
  dataInicio DateTime  @default(now())
  dataFim    DateTime?
  createdAt  DateTime  @default(now())

  @@unique([pessoaId, funcaoId, dataInicio])
  @@index([funcaoId, dataFim])
}

model FuncaoProcesso {
  id              String          @id @default(uuid())
  funcaoId        String
  funcao          Funcao          @relation(fields: [funcaoId], references: [id])
  xprocProcessoId String
  papel           PapelNoProcesso
  observacao      String?
  createdAt       DateTime        @default(now())
  deletedAt       DateTime?

  @@unique([funcaoId, xprocProcessoId])
  @@index([deletedAt])
}

enum PapelNoProcesso {
  RESPONSIBLE
  ACCOUNTABLE
  CONSULTED
  INFORMED
}

// ═══════════════════════════════════════════════════════════════
// AREA
// ═══════════════════════════════════════════════════════════════

model Area {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  nome     String
  parentId String?
  parent   Area?   @relation("AreaHierarchy", fields: [parentId], references: [id])
  children Area[]  @relation("AreaHierarchy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  impactAreas ImpactArea[]

  @@unique([tenantId, nome])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════
// CHANGE IMPACT (M3)
// ═══════════════════════════════════════════════════════════════

enum ImpactDimension {
  PROCESS
  PEOPLE
  TECHNOLOGY
  STRUCTURE
  CULTURE
  POLICY
  METRICS
}

enum ImpactStatus {
  DRAFT
  ACTIVE
  MITIGATING
  RESOLVED
  CLOSED
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

model ChangeImpact {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  title         String
  description   String?
  dimension     ImpactDimension
  status        ImpactStatus    @default(DRAFT)
  severityScore Int
  extentScore   Int
  score         Int
  mitigation    String?
  createdBy     String
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  activities       ImpactActivity[]
  areas            ImpactArea[]
  acompanhamentos  ImpactAcompanhamento[]
  trainingMatrices TrainingMatrix[]

  @@index([tenantId])
  @@index([projectId])
  @@index([dimension])
  @@index([status])
  @@index([deletedAt])
}

model ImpactActivity {
  id            String         @id @default(uuid())
  impactId      String
  impact        ChangeImpact   @relation(fields: [impactId], references: [id])
  title         String
  description   String?
  status        ActivityStatus @default(PENDING)
  dueDate       DateTime?
  assignedTo    String?
  smrActivityId String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([impactId])
  @@index([deletedAt])
}

model ImpactArea {
  id        String       @id @default(uuid())
  impactId  String
  impact    ChangeImpact @relation(fields: [impactId], references: [id])
  areaId    String
  area      Area         @relation(fields: [areaId], references: [id])
  note      String?
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  @@unique([impactId, areaId])
  @@index([deletedAt])
}

model ImpactAcompanhamento {
  id             String        @id @default(uuid())
  impactId       String
  impact         ChangeImpact  @relation(fields: [impactId], references: [id])
  previousStatus ImpactStatus?
  newStatus      ImpactStatus
  previousScore  Int?
  newScore       Int
  note           String?
  changedBy      String
  changedAt      DateTime      @default(now())

  @@index([impactId, changedAt])
}

// ═══════════════════════════════════════════════════════════════
// SMR WEBHOOK LOG
// ═══════════════════════════════════════════════════════════════

model SmrWebhookLog {
  id          String    @id @default(uuid())
  eventId     String    @unique
  activityId  String?
  payload     Json
  status      String    @default("RECEIVED")
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════
// TRAINING (M5)
// ═══════════════════════════════════════════════════════════════

enum TrainingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TrainingMatrix {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id])
  impactId    String?
  impact      ChangeImpact?    @relation(fields: [impactId], references: [id])
  title       String
  description String?
  dimension   ImpactDimension?
  targetRole  String?
  durationH   Int?
  mandatory   Boolean          @default(true)
  lmsModuleId String?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  plans TrainingPlan[]

  @@index([tenantId])
  @@index([projectId])
  @@index([impactId])
  @@index([deletedAt])
}

model TrainingPlan {
  id              String         @id @default(uuid())
  matrixId        String
  matrix          TrainingMatrix @relation(fields: [matrixId], references: [id])
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id])
  userId          String?
  stakeholderId   String?
  status          TrainingStatus @default(PENDING)
  dueDate         DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  lmsEnrollmentId String?        @unique
  lmsScore        Int?           @db.SmallInt
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([matrixId])
  @@index([projectId])
  @@index([userId])
  @@index([stakeholderId])
  @@index([status])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════
// EVENTO INTEGRACAO
// ═══════════════════════════════════════════════════════════════

model EventoIntegracao {
  id          String         @id @default(uuid())
  tipo        String
  payload     Json
  origem      SistemaOrigem
  destino     SistemaOrigem?
  status      StatusEvento   @default(PENDENTE)
  tentativas  Int            @default(0)
  ultimoErro  String?
  createdAt   DateTime       @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([tipo, createdAt])
}

enum SistemaOrigem {
  SMR
  XPROC
  COLLAB
}

enum StatusEvento {
  PENDENTE
  PROCESSANDO
  PROCESSADO
  FALHADO
  DESCARTADO
}
