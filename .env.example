# ═══════════════════════════════════════════════════════════════
# Collab Engine — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════
#
# Copie este arquivo para .env.local (desenvolvimento) ou configure
# no provedor de hospedagem (produção).
#
# IMPORTANTE: .env.local NÃO deve ser comitado (já está no .gitignore).
#

# ───── Banco de dados ─────────────────────────────────────────
# Connection string do PostgreSQL.
# DATABASE_URL: usa pooler (PgBouncer) em produção, recomendado em prod.
# DIRECT_URL: conexão direta, usada por Prisma migrate.
# Em dev local com docker-compose, ambas apontam pro mesmo Postgres.
DATABASE_URL="postgresql://collab:collab_dev_password@localhost:5432/collab_engine?schema=public"
DIRECT_URL="postgresql://collab:collab_dev_password@localhost:5432/collab_engine?schema=public"

# ───── Autenticação ───────────────────────────────────────────
# Segredo para assinar JWT.
# DEVE ter mínimo 32 caracteres aleatórios.
# Em produção, gere com: openssl rand -base64 32
# IMPORTANTE: a mesma JWT_SECRET deve estar nos três sistemas
# (SMR, XPROC, Collab Engine) para SSO funcionar (ADR-005).
JWT_SECRET="change-me-in-production-use-32-plus-random-characters"

# Domínio do cookie de sessão.
# Em desenvolvimento local: deixe vazio (cookie só vale em localhost).
# Em produção: ".collabz.com.br" (com ponto na frente, vale em todos subdomínios).
COOKIE_DOMAIN=""

# Nome do cookie. Em produção, use "collabz_session" (alinhado com SMR e XPROC).
COOKIE_NAME="collab_session"

# ───── E-mail (Resend) ─────────────────────────────────────────
# Para envio de convites de treinamento, notificações, etc.
# Pegue chave em https://resend.com (free tier suficiente para dev).
# Em dev, pode deixar vazio — emails serão logados em vez de enviados.
RESEND_API_KEY=""
EMAIL_FROM="Collab Engine <noreply@collabz.com.br>"

# ───── Anthropic (IA) ──────────────────────────────────────────
# Para Human Change Engine (M5 sugestões automáticas, M3 análise de impacto, etc.).
# Adiado para sprint posterior — pode deixar vazio no MVP.
ANTHROPIC_API_KEY=""

# ───── Integrações ─────────────────────────────────────────────
# URLs e chaves dos sistemas SMR e XPROC.
# Configurados quando integração for ativada (sprint-3+).
SMR_API_URL=""
SMR_API_KEY=""

XPROC_API_URL=""
XPROC_API_KEY=""

# ───── Aplicação ───────────────────────────────────────────────
# URL pública do Collab Engine.
# Em dev: http://localhost:3000
# Em prod: https://collab.collabz.com.br
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ambiente.
NODE_ENV="development"

# ───── SSO / Webhooks (Issue 007 — Sprint 1) ──────────────────
# Segredo HMAC para validar webhooks recebidos do SMR (user.created, user.updated).
# Deve ter 32+ caracteres. O SMR usa o mesmo valor como COLLAB_WEBHOOK_SECRET.
# Em produção, gere com: openssl rand -base64 32
WEBHOOK_SECRET=""

# ───── Cron (Issue 027 — notificações automatizadas) ──────────
# Segredo Bearer para autenticar chamadas de cron
# (POST /api/cron/process-events e /api/cron/training-notifications).
# Gere com: openssl rand -base64 32
CRON_SECRET=""

# ───── Observabilidade (opcional no MVP) ───────────────────────
# Sentry para error tracking.
SENTRY_DSN=""

# Log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"
